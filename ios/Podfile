# Disable New Architecture
# ENV['RCT_NEW_ARCH_ENABLED'] = '0'
ENV['RCT_HERMES_V1_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
    'require.resolve(
        "react-native/scripts/react_native_pods.rb",
        {paths: [process.argv[1]]},
    )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
    Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
    use_frameworks! :linkage => linkage.to_sym
end

target 'MyUiDemo' do
    config = use_native_modules!
    use_react_native!(
        :path => config[:reactNativePath],
        :hermes_enabled => true,
        :app_path => "#{Pod::Config.instance.installation_root}/.."
    )

    post_install do |installer|
        react_native_post_install(
            installer,
            config[:reactNativePath],
            :mac_catalyst_enabled => false
        )

        minimum_deployment_target = Gem::Version.new(min_ios_version_supported)
        installer.pods_project.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_deployment_target.to_s
        end

        react_core_headers = '$(PODS_ROOT)/React-Core-prebuilt/React.xcframework/Headers'
        installer.pods_project.targets.each do |target|
            target.build_configurations.each do |config|
                deployment_target = Gem::Version.new(
                    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || min_ios_version_supported
                )
                config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] =
                    [deployment_target, minimum_deployment_target].max.to_s
                header_search_paths = Array(config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)')
                config.build_settings['HEADER_SEARCH_PATHS'] = header_search_paths | [react_core_headers]
            end
        end
    end
end
